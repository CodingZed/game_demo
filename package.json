{
  "name": "little-sky-club",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/prepare-site.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:offline": "playwright test --config playwright.production.config.js",
    "build:standalone": "node scripts/build-standalone.mjs"
  },
  "dependencies": {
    "three": "0.181.2"
  },
  "devDependencies": {
    "vite": "6.4.1",
    "@playwright/test": "1.56.1"
  }
}
